# ============================================================
# inputs.ib_square — native 2D coupled IB projection smoke test
#
# Use with the AMREX_SPACEDIM=2 executable:
#   ./build-release/src/ins_solver_2d tests/2d/ib_square/inputs.ib_square
# ============================================================

geometry.prob_lo     =  0.0                0.0
geometry.prob_hi     =  6.283185307179586  6.283185307179586
geometry.is_periodic =  1  1

amr.n_cell           =  32  32
amr.max_level        =  0
amr.blocking_factor  =  4
amr.max_grid_size    =  32
amr.v                =  1

ins.nu               =  1.0e-2
ins.cfl              =  0.5
ins.t_stop           =  5.0
ins.max_step         =  1
ins.plot_int         =  0
ins.cn_order         =  2
ins.poisson_tol      =  1.0e-10
ins.poisson_max_iter =  1000
ins.verbose          =  2
ins.plot_prefix      =  plt_ib_square_2d

ib.geometry          =  tests/2d/ib_square/ib_square.curve
ib.velocity          =  0.0  0.0
